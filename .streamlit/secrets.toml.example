# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit it.

# Primary AI provider — Alibaba Cloud Model Studio, Qwen3.5-Flash, EU/Frankfurt region
DASHSCOPE_API_KEY = "sk-your-key-here"
DASHSCOPE_WORKSPACE_ID = "your-workspace-id"

# Fallback AI provider — used automatically if Qwen fails or isn't configured
GROQ_API_KEY = "gsk_your-key-here"

# Paste the full contents of your career profile MD file here (for Streamlit Cloud).
# Locally the app reads the file directly, so this is only needed on the cloud.
career_profile = """
# Mehdi Mokhtari - Master Career Knowledge Base
... paste full file content here ...
"""

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "abc123..."
private_key = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email = "job-tracker@your-project.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/job-tracker%40your-project.iam.gserviceaccount.com"
