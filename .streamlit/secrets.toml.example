# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit it.

# Primary AI provider — OpenRouter, routing to openai/gpt-oss-120b
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Fallback AI provider — used automatically if OpenRouter fails or isn't configured
GROQ_API_KEY = "gsk_your-key-here"

# Optional — only needed for the 📦 Bulk Email Update (Gmail) tab. See README's
# "Bulk Email Update (Gmail)" section for how to create these. Gmail access requested
# is read-only (gmail.readonly) — never send/modify/delete/label permissions. Use your
# deployed Streamlit Cloud app's own URL as the redirect URI here (not localhost).
GOOGLE_GMAIL_CLIENT_ID = "your-client-id.apps.googleusercontent.com"
GOOGLE_GMAIL_CLIENT_SECRET = "your-client-secret"
GOOGLE_GMAIL_REDIRECT_URI = "https://your-app-name.streamlit.app"

# Paste the full contents of your career profile MD file here (for Streamlit Cloud).
# Locally the app reads the file directly, so this is only needed on the cloud.
career_profile = """
# Mehdi Mokhtari - Master Career Knowledge Base
... paste full file content here ...
"""

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "abc123..."
private_key = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email = "job-tracker@your-project.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/job-tracker%40your-project.iam.gserviceaccount.com"
