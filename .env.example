# Required — the app fails closed (shows a config error, no access) without this.
# Pick a strong, unique password; it's never written to the URL, a cookie, or
# localStorage — only kept in the current Streamlit session's memory.
APP_PASSWORD=replace-with-a-strong-random-password

# Primary AI provider — OpenRouter, routing to openai/gpt-oss-120b
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Fallback AI provider — used automatically if OpenRouter fails or isn't configured
GROQ_API_KEY=gsk_your-key-here

GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional — only needed for the 📦 Bulk Email Update (Gmail) tab. See README's
# "Bulk Email Update (Gmail)" section for how to create these. Gmail access requested
# is read-only (gmail.readonly) — never send/modify/delete/label permissions.
GOOGLE_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=your-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8501
