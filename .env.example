# Primary AI provider — Qwen3.5-Flash via QwenCloud's OpenAI-compatible endpoint
# (dashscope-intl.aliyuncs.com — Alibaba Cloud's Singapore/International region,
# not EU/Frankfurt — see README for why)
DASHSCOPE_API_KEY=sk-your-key-here

